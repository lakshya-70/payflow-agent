{
  "name": "payflow-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PayFlow Agent backend: Express API + PayPal MCP server integration + LLM agent loop.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "smoke:mcp": "tsx src/scripts/mcp-smoke-test.ts",
    "tools:dry-run": "tsx src/scripts/tool-dry-run.ts",
    "negotiation-check": "tsx src/scripts/negotiation-check.ts",
    "demo:agent": "tsx src/scripts/demo-agent.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/mcp": "^1.8.1",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openai": "^4.86.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
