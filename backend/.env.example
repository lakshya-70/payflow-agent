# ── PayFlow Agent backend (.env) ─────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# PayPal sandbox credentials: https://developer.paypal.com/dashboard/
#   → Apps & Credentials → switch the toggle to SANDBOX → create app
#   → copy the Client ID and Secret into the fields below.

# Express API
PORT=4000
NODE_ENV=development

# ── PayPal (Sandbox first — the whole project targets sandbox) ───────────────
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret_here

# Optional: reuse an existing sandbox access token (e.g. minted in Postman).
# When unset, the backend mints and auto-refreshes tokens via the OAuth API.
# PAYPAL_ACCESS_TOKEN=A21AA...

# ── LLM (agent reasoning) ────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible gateway (Groq, Azure, Ollama, …)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# ── PayPal MCP server (@paypal/mcp) ──────────────────────────────────────────
# Tool filter passed to the MCP server: "all" or a comma-separated list, e.g.:
# PAYPAL_MCP_TOOLS=orders.create,orders.get,orders.capture,transactions.list
PAYPAL_MCP_TOOLS=all

# ── Agent guardrails ─────────────────────────────────────────────────────────
# USD amount at/above which orders require human admin approval before PayPal
# creates the order (human-in-the-loop gate exercisable from the dashboard).
PAYFLOW_APPROVAL_THRESHOLD=500

# ── Payouts (Step 4) ─────────────────────────────────────────────────────────
# "api"  = real PayPal Payouts REST calls (sender account country must support
#          Payouts; India is NOT supported as sender)
# "mock" = clearly-labeled simulated payouts (demo-safe, no REST calls)
PAYOUTS_MODE=api

# Optional webhook id for POST /api/webhooks/paypal signature verification
# (developer dashboard → Your apps → Webhooks). Unset = accept demo events.
# PAYPAL_WEBHOOK_ID=

# ── Frontend / CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
FRONTEND_ORIGIN=http://localhost:3000
